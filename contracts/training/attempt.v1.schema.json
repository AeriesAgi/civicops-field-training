{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AeriesAgi/civicops-field-training/contracts/training/attempt.v1.schema.json",
  "title": "CivicOps VR training attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","attemptId","moduleId","moduleVersion","scenarioId","traineeId","crewId","startedAt","completedAt","durationMs","steps","criticalErrors","score","passed","inputMode","accessibility","device","instructor"],
  "properties": {
    "schema": { "const": "civicops.training.attempt.v1" },
    "attemptId": { "type": "string", "format": "uuid" },
    "moduleId": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "moduleVersion": { "type": "integer", "minimum": 1 },
    "scenarioId": { "type": "string", "maxLength": 80 },
    "traineeId": { "type": "string", "maxLength": 80 },
    "crewId": { "type": "string", "pattern": "^[a-z]+-[0-9]{2}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 3600000 },
    "steps": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stepId","outcome","atMs","hintsUsed"],
        "properties": {
          "stepId": { "type": "string", "maxLength": 60 },
          "outcome": { "enum": ["correct","out-of-order","skipped","unsafe"] },
          "atMs": { "type": "integer", "minimum": 0 },
          "hintsUsed": { "type": "integer", "minimum": 0 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "criticalErrors": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 120 } },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "passed": { "type": "boolean" },
    "inputMode": { "enum": ["hands","gaze-hands"] },
    "accessibility": {
      "type": "object", "additionalProperties": false,
      "required": ["oneHanded","gazePinch","highContrast","captions","seated","benchHeightOffset"],
      "properties": {
        "oneHanded": { "type": "boolean" }, "gazePinch": { "type": "boolean" },
        "highContrast": { "type": "boolean" }, "captions": { "type": "boolean" },
        "seated": { "type": "boolean" }, "benchHeightOffset": { "type": "number", "minimum": -0.4, "maximum": 0.4 }
      }
    },
    "device": {
      "type": "object", "additionalProperties": false, "required": ["runtime","deviceName"],
      "properties": { "runtime": { "enum": ["emulated","native"] }, "deviceName": { "type": "string", "maxLength": 60 } }
    },
    "instructor": {
      "type": "object", "additionalProperties": false, "required": ["mode","hintsRequested"],
      "properties": { "mode": { "enum": ["off","scripted","elevenlabs-agent"] }, "hintsRequested": { "type": "integer", "minimum": 0 } }
    }
  }
}
