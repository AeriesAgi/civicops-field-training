{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/board.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "vr",
      "offer": "always",
      "features": {
        "handTracking": true,
        "gazeTracking": true,
        "eyeTracking": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "near": 0.001,
      "far": 120,
      "camera": {
        "position": [
          0.05,
          1.43,
          1.1
        ],
        "lookAt": [
          0,
          1.15,
          -0.5
        ]
      }
    },
    "features": {
      "locomotion": {
        "turningMethod": "snap",
        "enableJumping": false,
        "comfortAssistLevel": 1,
        "browserControls": false
      },
      "grabbing": true,
      "physics": false,
      "sceneUnderstanding": false,
      "environmentRaycast": false,
      "spatialUI": {
        "kit": "default"
      }
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "meeting_room"
    }
  }
}
