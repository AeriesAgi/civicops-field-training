<style>
  .captions-bar { flex-direction: column; width: 65; height: 12; justify-content: center; background-color: #173d38; border-color: #a5bfa9; border-width: 0.08; border-radius: 0.9; padding-top: 1.1; padding-bottom: 1.1; padding-left: 2; padding-right: 2; gap: 0.6; }
  .captions-label { font-size: 3; font-weight: 700; color: #f5d78c; }
  .captions-caption { font-size: 2.2; font-weight: 700; line-height: 1.18; color: #ffffff; }
</style>
<div id="panel-root" class="captions-bar">
