<style>
  .fire-controls { flex-direction: column; width: 32; height: 56; background-color: #f7f3e9; color: #103d50; border-color: #bad3d8; border-width: 0.08; border-radius: 1; padding-top: 1.1; padding-bottom: 1.1; padding-left: 1.4; padding-right: 1.4; gap: 0.55; }
  .fire-title { height: 4.7; flex-shrink: 0; font-size: 3.4; font-weight: 700; line-height: 1.1; }
  .fire-gauge { flex-direction: row; justify-content: space-between; align-items: center; height: 4.2; flex-shrink: 0; background-color: #103d50; border-radius: 0.5; padding-left: 0.8; padding-right: 0.8; }
  .fire-reading { height: 3.6; flex-shrink: 0; font-size: 2.3; font-weight: 700; line-height: 1.1; color: #ffffff; }
  .fire-status { height: 11; flex-shrink: 0; font-size: 2.4; font-weight: 700; line-height: 1.15; justify-content: center; padding-left: 0.8; padding-right: 0.8; background-color: #c8e9ed; border-radius: 0.5; }
  .fire-action-row { flex-direction: row; justify-content: space-between; gap: 0.6; height: 6.2; flex-shrink: 0; }
  .fire-action { width: 14.1; height: 6.2; flex-shrink: 0; justify-content: center; align-items: center; background-color: #103d50; color: #ffffff; border-radius: 0.6; font-size: 2.7; font-weight: 700; line-height: 1.1; text-align: center; cursor: pointer; }
  .fire-action-safe { background-color: #174d2c; }
  .fire-action-secondary { background-color: #e3ebe5; color: #103d50; border-color: #103d50; border-width: 0.06; }
  .fire-notice { height: 8.4; flex-shrink: 0; font-size: 2.7; line-height: 1.15; }
</style>
<div id="panel-root" class="fire-controls">
  <div id="action-title" class="fire-title">SCENE SAFETY</div>
  <div class="fire-gauge"><div id="found-count" class="fire-reading">Hazards 0 / 4</div><div id="tag-count" class="fire-reading">Tags 0 / 4</div></div>
  <div id="zone-status" class="fire-status">Pinch-place parts.
Poke each hazard.</div>
  <div class="fire-action-row"><button id="mark-approach" class="fire-action fire-action-safe">Mark
approach</button><button id="send-handover" class="fire-action fire-action-safe">Send
handover</button></div>
  <div class="fire-action-row"><button id="hint" class="fire-action fire-action-secondary">Hint</button><button id="reset" class="fire-action fire-action-secondary">Reset</button></div>
  <div class="fire-action-row"><button id="daily-drill" class="fire-action fire-action-secondary">Daily
drill</button><button id="jobs" class="fire-action fire-action-secondary">Jobs</button></div>
  <div class="fire-notice">Line stays live until
Electricity confirms.
A human decides.</div>
</div>
