<style>
  .steps-card { flex-direction: column; width: 34; height: 36.5; background-color: #f7f3e9; border-color: #d5ddcf; border-width: 0.08; border-radius: 1.1; padding-top: 1.5; padding-bottom: 1.5; padding-left: 1.6; padding-right: 1.6; gap: 0.6; color: #173d38; }
  .steps-lesson { flex-direction: column; gap: 0.6; }
  .intro-body { flex-direction: column; gap: 1.1; }
  .intro-title { font-size: 4.2; font-weight: 700; line-height: 1.12; }
  .intro-copy { font-size: 2.7; line-height: 1.2; }
  .intro-button { height: 6; justify-content: center; align-items: center; background-color: #173d38; color: #ffffff; font-size: 2.7; font-weight: 700; border-radius: 0.6; cursor: pointer; }
  .intro-secondary { background-color: #e7ede4; color: #173d38; }
  .steps-why { width: 5; height: 4; background-color: #173d38; color: #ffffff; font-size: 3.2; font-weight: 700; justify-content: center; align-items: center; border-radius: 2; cursor: pointer; }
  .steps-header { flex-direction: row; justify-content: space-between; align-items: center; gap: 0.4; }
  .intro-header { height: 3.4; }
  .steps-jobs { width: 7; height: 3.4; justify-content: center; align-items: center; background-color: #173d38; color: #ffffff; border-radius: 0.55; font-size: 2.7; font-weight: 700; cursor: pointer; }
  .steps-eyebrow { height: 3.4; line-height: 1.1; font-size: 2.7; font-weight: 700; color: #173d38; }
  .steps-current { height: 9.5; justify-content: center; font-size: 4.2; font-weight: 700; line-height: 1.12; color: #173d38; background-color: #f5d78c; border-radius: 0.6; padding-left: 1; padding-right: 1; }
  .steps-row { flex-direction: row; justify-content: space-between; gap: 0.6; }
  .steps-step { width: 7.2; height: 4.4; justify-content: center; align-items: center; text-align: center; font-size: 2.7; font-weight: 700; line-height: 1.1; color: #173d38; background-color: #e7ede4; border-radius: 0.6; }
  .steps-legend { height: 3.4; font-size: 2.7; line-height: 1.1; color: #173d38; }
</style>
<div id="panel-root" class="steps-card">
  <div id="intro-body" class="intro-body" style="display: none;">
    <div class="steps-header intro-header"><div id="intro-eyebrow" class="steps-eyebrow">FIRST 5 MIN</div><button id="jobs-intro" class="steps-jobs">Jobs</button></div>
    <div id="intro-title" class="intro-title">First lock</div>
    <div id="intro-copy" class="intro-copy">Switch off. Lock. Tag.
A 90-second practice.</div>
    <button id="intro-primary" class="intro-button">Try first lock</button>
    <button id="intro-secondary" class="intro-button intro-secondary">Full lesson</button>
  </div>
  <div id="lesson-body" class="steps-lesson">
  <div id="steps-header" class="steps-header"><div class="steps-eyebrow">NEXT STEP</div><button id="jobs-lesson" class="steps-jobs">Jobs</button><button id="explain-why" class="steps-why">?</button></div>
  <div id="current-step" class="steps-current">Confirm circuit</div>
  <div id="check-row-1" class="steps-row">
    <div id="step-1" class="steps-step">&gt; 1</div>
    <div id="step-2" class="steps-step">[ ] 2</div>
    <div id="step-3" class="steps-step">[ ] 3</div>
  </div>
  <div id="check-row-2" class="steps-row">
    <div id="step-4" class="steps-step">[ ] 4</div>
    <div id="step-5" class="steps-step">[ ] 5</div>
    <div id="step-6" class="steps-step">[ ] 6</div>
  </div>
  <div id="check-row-3" class="steps-row">
    <div id="step-7" class="steps-step">[ ] 7</div>
    <div id="step-8" class="steps-step">[ ] 8</div>
    <div id="step-9" class="steps-step">[ ] 9</div>
    <div id="step-10" class="steps-step">[ ] 10</div>
  </div>
  <div id="steps-footer" class="steps-row"><div id="steps-legend" class="steps-legend">&gt; NEXT  [x] DONE</div><button id="repeat-demo" class="steps-why" style="width: 9; font-size: 2.7;">Demo</button></div>
  </div>
</div>
