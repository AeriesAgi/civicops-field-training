<style>
  .roads-controls { flex-direction: column; width: 32; height: 52; background-color: #f7f3e9; color: #103d50; border-color: #bad3d8; border-width: 0.08; border-radius: 1; padding-top: 1.1; padding-bottom: 1.1; padding-left: 1.4; padding-right: 1.4; gap: 0.55; }
  .roads-title { height: 4.7; flex-shrink: 0; font-size: 4.2; font-weight: 700; line-height: 1.1; }
  .roads-gauge { flex-direction: row; justify-content: space-between; align-items: center; height: 4.2; flex-shrink: 0; background-color: #103d50; border-radius: 0.5; padding-left: 0.8; padding-right: 0.8; }
  .roads-reading { height: 3.6; flex-shrink: 0; font-size: 2.7; font-weight: 700; line-height: 1.1; color: #ffffff; }
  .roads-speed { width: 12.4; }
  .roads-beacon { width: 15.2; text-align: right; }
  .roads-status { height: 6.2; flex-shrink: 0; font-size: 2.7; font-weight: 700; line-height: 1.15; justify-content: center; padding-left: 0.8; padding-right: 0.8; background-color: #c8e9ed; border-radius: 0.5; }
  .roads-action-row { flex-direction: row; justify-content: space-between; gap: 0.6; height: 6.2; flex-shrink: 0; }
  .roads-action { width: 14.1; height: 6.2; flex-shrink: 0; justify-content: center; align-items: center; background-color: #103d50; color: #ffffff; border-radius: 0.6; font-size: 2.7; font-weight: 700; line-height: 1.1; text-align: center; cursor: pointer; }
  .roads-action-safe { background-color: #174d2c; }
  .roads-action-secondary { background-color: #e3ebe5; color: #103d50; border-color: #103d50; border-width: 0.06; }
  .roads-notice { height: 9.6; flex-shrink: 0; font-size: 2.7; line-height: 1.15; }
  .roads-hidden { display: none; }
</style>
<div id="panel-root" class="roads-controls">
  <div class="roads-action-row" style="height: 4.7;"><div id="action-title" class="roads-title" style="width: 15; font-size: 3.2;">ROAD ZONE</div><button id="weather-toggle" class="roads-action" style="height: 4.7; width: 12;">STORM</button></div>
  <div class="roads-gauge"><div id="speed-limit" class="roads-reading roads-speed">60 km/h</div><div id="beacon-status" class="roads-reading roads-beacon">OFF</div></div>
  <div id="zone-status" class="roads-status">PLACE UPSTREAM
Protect the approach.</div>
  <div id="action-copy" class="roads-hidden">Pinch-place parts. Twist to rotate.</div>
  <div class="roads-action-row"><button id="beacon-toggle" class="roads-action">Beacon: off</button><button id="work-start" class="roads-action roads-action-secondary">Request
work</button></div>
  <div class="roads-action-row"><button id="zone-check" class="roads-action roads-action-safe">Zone
check</button><button id="run-traffic" class="roads-action roads-action-safe">Run
traffic</button></div>
  <div id="traffic-actions" class="roads-action-row" style="display: none;"><button id="stop-go-toggle" class="roads-action">Stop / Go</button><button id="traffic-finish" class="roads-action">Finish
run</button></div>
  <div id="incident-actions" class="roads-action-row" style="display: none;"><button id="incident-action" class="roads-action roads-action-safe">Refuge checked</button><button id="incident-unsafe" class="roads-action roads-action-secondary">Enter live lane</button></div>
  <div class="roads-action-row"><button id="hint" class="roads-action roads-action-secondary">Hint</button><button id="reset" class="roads-action roads-action-secondary">Reset</button></div>
  <div class="roads-notice">You decide the work.
Follow employer SOPs.</div>
</div>
