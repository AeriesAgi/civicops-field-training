<style>
  .fire-card { flex-direction: column; width: 28; height: 24; background-color: #f7f3e9; color: #103d50; border-color: #103d50; border-width: 0.1; border-radius: 0.8; padding-top: 1.2; padding-bottom: 1.2; padding-left: 1.3; padding-right: 1.3; gap: 0.6; }
