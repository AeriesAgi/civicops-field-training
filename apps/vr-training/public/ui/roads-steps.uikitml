<style>
  .roads-lesson { flex-direction: column; width: 32; height: 52; background-color: #f7f3e9; color: #103d50; border-color: #bad3d8; border-width: 0.08; border-radius: 1; padding-top: 1.3; padding-bottom: 1.3; padding-left: 1.5; padding-right: 1.5; gap: 0.7; }
  .roads-heading { flex-direction: row; justify-content: space-between; align-items: center; height: 4; flex-shrink: 0; }
  .roads-eyebrow { font-size: 2.7; font-weight: 700; line-height: 1.1; }
  .roads-why { width: 4; height: 3.5; justify-content: center; align-items: center; background-color: #103d50; color: #ffffff; border-radius: 1.7; font-size: 2.7; font-weight: 700; cursor: pointer; }
  .roads-jobs { width: 8; height: 3.5; justify-content: center; align-items: center; background-color: #103d50; color: #ffffff; border-radius: 0.5; font-size: 2.7; font-weight: 700; cursor: pointer; }
  .roads-current { height: 10; flex-shrink: 0; font-size: 4.2; font-weight: 700; line-height: 1.12; justify-content: center; padding-left: 1; padding-right: 1; background-color: #c8e9ed; border-radius: 0.6; }
  .roads-caption { height: 12.8; flex-shrink: 0; font-size: 2.7; line-height: 1.15; }
  .roads-checks { flex-direction: row; justify-content: space-between; gap: 0.35; height: 3.8; flex-shrink: 0; }
  .roads-check { width: 3.8; height: 3.8; font-size: 2.7; font-weight: 700; justify-content: center; align-items: center; border-radius: 0.5; background-color: #e3ebe5; color: #103d50; }
  .roads-notice { height: 9.6; flex-shrink: 0; font-size: 2.7; line-height: 1.15; }
  .roads-footer { height: 3.5; flex-shrink: 0; margin-bottom: 0.4; font-size: 2.7; line-height: 1.1; }
</style>
<div id="panel-root" class="roads-lesson">
  <div class="roads-heading"><div class="roads-eyebrow">ROADS</div><button id="back-to-jobs" class="roads-jobs">Jobs</button><button id="explain-why" class="roads-why">?</button></div>
  <div id="current-step" class="roads-current">Park upstream</div>
  <div id="caption" class="roads-caption">Pinch the crew van.
Park upstream.
Turn the beacon on.</div>
  <div class="roads-checks">
    <div id="step-1" class="roads-check">1</div><div id="step-2" class="roads-check">2</div><div id="step-3" class="roads-check">3</div><div id="step-4" class="roads-check">4</div><div id="step-5" class="roads-check">5</div><div id="step-6" class="roads-check">6</div><div id="step-7" class="roads-check">7</div>
  </div>
  <div id="step-progress" class="roads-footer">0 / 7 complete</div>
  <div id="safety-notice" class="roads-notice">Illustrative training.
Follow employer SOPs.</div>
</div>
